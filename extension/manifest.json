{
  "manifest_version": 3,
  "name": "Reels Studio – Google Ảnh và Đối thủ",
  "version": "1.7.1",
  "key": "",
  "description": "Lấy ảnh Google Ảnh cho cảnh video và đọc lưới Reels của đối thủ Facebook, ngay trong Chrome của thành viên.",
  "permissions": ["contextMenus", "tabs", "storage", "scripting", "cookies"],
  "incognito": "spanning",
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "host_permissions": ["https://www.google.com/*", "https://www.facebook.com/*", "https://*.facebook.com/*", "https://*.fbcdn.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://reels.quangdang.xyz/*", "http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["app.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["google-results.js", "google.js"],
      "run_at": "document_idle"
    }
  ]
}
