# Cloudflare static-asset headers (OpenNext copies public/ into .open-next/assets). Hashed build files never
# change under the same name, so the browser keeps them instead of revalidating each one on every page load.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# "Có gì mới" (web/scripts/changelog.ts): rewritten on each deploy, and open tabs read it to see a newer version.
/changelog.json
  Cache-Control: no-cache
