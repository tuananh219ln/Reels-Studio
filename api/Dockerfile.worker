# Production image for the worker (script and render jobs), built by Coolify from the repo root
# (base directory /, Dockerfile /api/Dockerfile.worker). Same packages as the api image plus FFmpeg,
# and HyperFrames (Node, its headless Chrome and GSAP) for "Cảnh động" (api/src/reels_api/motion.py).
# Coolify sets DATABASE_URL, ANTHROPIC_API_KEY, PIXABAY_API_KEY, ELEVENLABS_API_KEY and STORAGE_DIR.
FROM node:22-slim AS node

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

# The renderer uses only filters available since FFmpeg 4.3; Debian's package is newer.
# The other packages are what HyperFrames' headless Chrome needs to start.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
      ca-certificates fonts-liberation libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libcairo2 \
      libcups2t64 libdbus-1-3 libdrm2 libexpat1 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 \
      libstdc++6 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    && rm -rf /var/lib/apt/lists/*

# Node 22 from the official image, then HyperFrames and the GSAP its scenes load, pinned. HyperFrames keeps its
# Chrome in a cache folder the app user can read; motion.py finds GSAP beside the CLI.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
ENV HYPERFRAMES_CACHE_DIR=/opt/hyperframes/cache HYPERFRAMES_NO_UPDATE_CHECK=1 HYPERFRAMES_NO_TELEMETRY=1 \
    DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 HYPERFRAMES_NO_OPTIONAL_INSTALL=1 PATH=/opt/hyperframes/node_modules/.bin:$PATH
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && mkdir -p /opt/hyperframes && cd /opt/hyperframes \
    && npm init -y >/dev/null && npm install --no-fund --no-audit hyperframes@0.9.19 gsap@3.15.0 \
    && hyperframes browser ensure \
    && printf '#!/bin/sh\n# Every address but this machine (HyperFrames serves the scene on loopback) goes to a dead proxy.\nexec "%s" --proxy-server=http://127.0.0.1:9 "$@"\n' "$(hyperframes browser path)" > /opt/hyperframes/chrome-offline \
    && chmod -R a+rX /opt/hyperframes && chmod a+x /opt/hyperframes/chrome-offline
# The markup of a "Cảnh động" is written by an AI: its Chrome reaches nothing outside the container.
ENV PRODUCER_HEADLESS_SHELL_PATH=/opt/hyperframes/chrome-offline

# "Sửa ảnh" › "Xóa vùng" (api/src/reels_api/image_edit.py): LaMa as ONNX (Apache-2.0, about 200 MB), pinned to one
# revision and checked against its SHA-256, so a changed file fails the build instead of reaching the worker.
ARG LAMA_URL=https://huggingface.co/Carve/LaMa-ONNX/resolve/c3c0c9e468934d62e79c329e35d82dd09ff8c444/lama_fp32.onnx
ARG LAMA_SHA256=1faef5301d78db7dda502fe59966957ec4b79dd64e16f03ed96913c7a4eb68d6
ENV LAMA_MODEL_PATH=/opt/lama/lama_fp32.onnx
RUN mkdir -p /opt/lama \
    && python -c "import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" "$LAMA_URL" "$LAMA_MODEL_PATH" \
    && echo "$LAMA_SHA256  $LAMA_MODEL_PATH" | sha256sum -c - \
    && chmod -R a+rX /opt/lama
# "Sửa ảnh" › "Tìm chữ/logo tự động": PP-OCRv4's text detector as ONNX (Apache-2.0, about 5 MB), pinned the same way.
ARG TEXT_DETECT_URL=https://huggingface.co/SWHL/RapidOCR/resolve/1cfba2e90fc938db55889873735088de210cc173/PP-OCRv4/ch_PP-OCRv4_det_infer.onnx
ARG TEXT_DETECT_SHA256=d2a7720d45a54257208b1e13e36a8479894cb74155a5efe29462512d42f49da9
ENV TEXT_DETECT_MODEL_PATH=/opt/lama/text_detect.onnx
RUN python -c "import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" "$TEXT_DETECT_URL" "$TEXT_DETECT_MODEL_PATH" \
    && echo "$TEXT_DETECT_SHA256  $TEXT_DETECT_MODEL_PATH" | sha256sum -c - \
    && chmod a+r "$TEXT_DETECT_MODEL_PATH"

COPY worker/pyproject.toml worker/
COPY worker/src worker/src
COPY api/pyproject.toml api/
COPY api/src api/src
RUN pip install ./worker "./api[inpaint]" && useradd --system --uid 10001 app && mkdir -p /data/storage && chown app /data/storage \
    && chown -R app /opt/hyperframes/cache

USER app
# A short scene through the same code the motion job runs, so a build whose Chrome cannot start fails here.
RUN mkdir -p /tmp/motion-check && HOME=/tmp python -m reels_api.motion /tmp/motion-check && rm -rf /tmp/motion-check
# A box erased by LaMa and words found by the text detector, through the same code the image_edit and image_marks jobs
# run, so a build whose models or onnxruntime cannot load fails here.
RUN python -m reels_api.image_edit

# Only one worker takes jobs (Postgres advisory lock): during a deploy the new container waits until
# the old one has stopped. SIGTERM kills the running job; the next worker marks it failed.
CMD ["python", "-m", "reels_api", "worker"]
