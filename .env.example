PIXABAY_API_KEY=
# api: optional second stock source for the scene picker; without a key the picker hides Pexels.
# Openverse needs no key and is always offered (public-domain works only).
PEXELS_API_KEY=
# api: optional Openverse registration for higher rate limits; anonymous use works without it
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# worker + api: Claude writes the scripts (https://console.anthropic.com) unless another provider is chosen
# on Cài đặt › Mô hình AI, where keys for every provider can also be entered; CLAUDE_MODEL is optional
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# api + worker: scene narration (https://elevenlabs.io); a key pasted on Cài đặt › Nguồn tư liệu wins over this
ELEVENLABS_API_KEY=
# api + worker, same values on both: optional voice and model (default "Adam", eleven_v3)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# worker: AI photos for scenes that have none — Gemini via Google AI Studio (https://aistudio.google.com/apikey)
# IMAGE_GEN_MODEL is optional (default gemini-2.5-flash-image)
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=
# api + worker, optional: the default AI photo provider (gemini or cloudflare) until one is chosen on
# Cài đặt › Nguồn tư liệu; empty: Cloudflare when it is set up, else Gemini
IMAGE_GEN_PROVIDER=
# worker: Cloudflare Workers AI (FLUX.1 schnell; free 10,000 neurons a day, about 57 photos).
# IMAGE_GEN_CF_API_KEY is an API token with Workers AI permission (it can also be pasted on Cài đặt › Nguồn tư liệu).
# IMAGE_GEN_CF_ACCOUNT_ID: on the Cloudflare dashboard, top right (Account ID). Not a secret.
# IMAGE_GEN_CF_MODEL is optional (default @cf/black-forest-labs/flux-1-schnell)
IMAGE_GEN_CF_API_KEY=
IMAGE_GEN_CF_ACCOUNT_ID=
IMAGE_GEN_CF_MODEL=
# api + worker: uploaded photos, thumbnails and MP4s; empty means data/storage at the repo root.
# In production one folder mounted into both containers: STORAGE_DIR=/data/storage
STORAGE_DIR=

# api: dev database (docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://reels:reels@127.0.0.1:5432/reels
# api: pytest database, created by docker/postgres-init on the first start
TEST_DATABASE_URL=postgresql+psycopg://reels:reels@127.0.0.1:5432/reels_test
# api: comma-separated origins allowed to send POST/PUT/PATCH/DELETE
ALLOWED_ORIGINS=http://localhost:3000
# web: where /api/* is forwarded (read by next dev and next build)
API_URL=http://127.0.0.1:8000
# api: true in production (HTTPS) so the session cookie gets the Secure flag; leave empty on localhost
COOKIE_SECURE=
# api: optional private ChatGPT MCP endpoint on the web origin; empty disables the connection.
# Example: https://reels.example.com/api/mcp (origin must be in ALLOWED_ORIGINS)
MCP_PUBLIC_URL=
# render machine only (python -m reels_api node, on a member's computer; not read by the api or the worker):
# the web address and the machine's token from Cài đặt › Máy render. api/scripts/render-node.ps1 sets both.
REELS_SERVER=
REELS_NODE_TOKEN=
# api + worker: the TikTok developer app (Login Kit + Content Posting API), the app's identity, not a member's.
# Members connect their own TikTok accounts on Cấu hình › Tài khoản affiliate. For the review demo, use the Sandbox's pair.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
