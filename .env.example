PIXABAY_API_KEY=

# api: dev database (docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://reels:reels@127.0.0.1:5432/reels
# api: pytest database, created by docker/postgres-init on the first start
TEST_DATABASE_URL=postgresql+psycopg://reels:reels@127.0.0.1:5432/reels_test
# api: comma-separated origins allowed to send POST/PUT/PATCH/DELETE
ALLOWED_ORIGINS=http://localhost:3000
# web: where /api/* is forwarded (read by next dev and next build)
API_URL=http://127.0.0.1:8000
# api: true in production (HTTPS) so the session cookie gets the Secure flag; leave empty on localhost
COOKIE_SECURE=
