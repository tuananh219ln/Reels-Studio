PIXABAY_API_KEY=
# api: optional second stock source for the scene picker; without a key the picker hides Pexels.
# Openverse needs no key and is always offered (public-domain works only).
PEXELS_API_KEY=
# api: optional Openverse registration for higher rate limits; anonymous use works without it
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# worker: Claude writes the scripts (https://console.anthropic.com); CLAUDE_MODEL is optional
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# worker: scene narration (https://elevenlabs.io)
ELEVENLABS_API_KEY=
# api + worker, same values on both: optional voice and model (default "Adam", eleven_v3)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# worker: AI photos for scenes that have none — Gemini via Google AI Studio (https://aistudio.google.com/apikey)
# IMAGE_GEN_MODEL is optional (default gemini-2.5-flash-image)
IMAGE_GEN_API_KEY=AIzaSyBztFBd1QbS9QLmQfl-qDpY2tMUkHyQiu4
IMAGE_GEN_MODEL=
# api + worker: uploaded photos, thumbnails and MP4s; empty means data/storage at the repo root.
# In production one folder mounted into both containers: STORAGE_DIR=/data/storage
STORAGE_DIR=

# api: dev database (docker compose up -d postgres)
DATABASE_URL=postgresql+psycopg://reels:reels@127.0.0.1:5432/reels
# api: pytest database, created by docker/postgres-init on the first start
TEST_DATABASE_URL=postgresql+psycopg://reels:reels@127.0.0.1:5432/reels_test
# api: comma-separated origins allowed to send POST/PUT/PATCH/DELETE
ALLOWED_ORIGINS=http://localhost:3000
# web: where /api/* is forwarded (read by next dev and next build)
API_URL=http://127.0.0.1:8000
# api: true in production (HTTPS) so the session cookie gets the Secure flag; leave empty on localhost
COOKIE_SECURE=
